#!/bin/bash
set -euxo pipefail

# --- install docker + compose v2 plugin ---
dnf update -y
dnf install -y docker
mkdir -p /usr/libexec/docker/cli-plugins
curl -SL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose
systemctl enable --now docker

# --- 2 GB swap (t3.small has only 2 GB RAM) ---
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- deploy entrypoint (invoked by SSM Run Command) ---
mkdir -p /opt/triage
cat > /opt/triage/run.sh <<'RUNEOF'
#!/bin/bash
set -euo pipefail
REGION="${region}"
SSM_PREFIX="${ssm_path_prefix}"
ECR_REGISTRY="${ecr_registry}"

aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$ECR_REGISTRY"

# Render SSM params into .env (strip the path prefix from each name).
aws ssm get-parameters-by-path --path "$SSM_PREFIX" --with-decryption --recursive \
  --region "$REGION" --query 'Parameters[].[Name,Value]' --output text \
  | while IFS=$'\t' read -r name value; do
      echo "$${name##*/}=$${value}"
    done > /opt/triage/.env

# Deploy-time vars provided by the caller's environment.
{
  echo "IMAGE_TAG=$${IMAGE_TAG:?missing IMAGE_TAG}"
  echo "ECR_BACKEND_URL=$${ECR_BACKEND_URL:?missing ECR_BACKEND_URL}"
  echo "ECR_FRONTEND_URL=$${ECR_FRONTEND_URL:?missing ECR_FRONTEND_URL}"
  echo "CORS_ORIGINS=$${CORS_ORIGINS:?missing CORS_ORIGINS}"
  echo "NEXTAUTH_URL=$${NEXTAUTH_URL:?missing NEXTAUTH_URL}"
  echo "DATABASE_URL=$${DATABASE_URL:-postgresql://triage:triage@postgres:5432/triage}"
  echo "BACKEND_URL=$${BACKEND_URL:-http://backend:8000}"
  echo "AUTH_TRUST_HOST=$${AUTH_TRUST_HOST:-true}"
} >> /opt/triage/.env

cd /opt/triage
docker compose --env-file /opt/triage/.env -f /opt/triage/docker-compose.yml pull
docker compose --env-file /opt/triage/.env -f /opt/triage/docker-compose.yml up -d --remove-orphans
docker image prune -f
RUNEOF
chmod +x /opt/triage/run.sh
